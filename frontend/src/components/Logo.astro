---
// Logotipo de Sure Developments.
// Hexágono (solidez, confianza) en azul profundo → celeste, con corchetes de código
// y una línea ascendente con una chispa (innovación y crecimiento).
interface Props { size?: number; class?: string }
const { size = 40, class: cls = '' } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 48 48" class={cls} role="img" aria-label="Sure Developments" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="sd-grad" x1="6" y1="4" x2="42" y2="44" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#0b1f4d" />
      <stop offset="0.55" stop-color="#1d4ed8" />
      <stop offset="1" stop-color="#0ea5e9" />
    </linearGradient>
  </defs>
  <path d="M24 2.5 42.6 13.25v21.5L24 45.5 5.4 34.75v-21.5Z" fill="url(#sd-grad)" />
  <path d="M24 6.6 39 15.3v17.4L24 41.4 9 32.7V15.3Z" fill="none" stroke="#fff" stroke-opacity=".18" stroke-width="1" />
  <g fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M17.5 17.5 12 24l5.5 6.5" />
    <path d="M30.5 17.5 36 24l-5.5 6.5" />
    <path d="M21 31.5 26.4 16.8" />
  </g>
  <circle cx="27.6" cy="13.4" r="2.3" fill="#7dd3fc" />
</svg>
