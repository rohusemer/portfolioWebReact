---
import Logo from './Logo.astro';
import AuthButton from './react/AuthButton';
import NavPanelLink from './react/NavPanelLink';
import HireButton from './react/HireButton';

const links = [
  { href: '#about', label: 'Sobre mí', icon: 'fa-user' },
  { href: '#skills', label: 'Habilidades', icon: 'fa-screwdriver-wrench' },
  { href: '#experience', label: 'Experiencia', icon: 'fa-briefcase' },
  { href: '#education', label: 'Educación', icon: 'fa-graduation-cap' },
  { href: '#projects', label: 'Proyectos', icon: 'fa-diagram-project' },
  { href: '/drawing-board', label: 'Pizarra', icon: 'fa-pen-ruler' },
];
---
<header
  id="main-header"
  class="fixed top-0 inset-x-0 z-40 border-b border-transparent bg-light-bg/70 dark:bg-dark-bg/70 backdrop-blur-xl transition-[box-shadow,border-color,background-color] duration-300"
>
  <nav class="container mx-auto flex items-center gap-4 px-4 h-16" aria-label="Principal">
    <!-- Marca -->
    <a href="/" class="flex items-center gap-3 shrink-0 group" aria-label="Sure Developments, inicio">
      <Logo size={40} class="drop-shadow-sm transition-transform duration-300 group-hover:-rotate-6 group-hover:scale-105" />
      <span class="flex flex-col leading-tight">
        <span class="text-[1.05rem] font-extrabold tracking-tight text-[#0b1f4d] dark:text-white">
          Sure <span class="bg-gradient-to-r from-[#1d4ed8] to-[#0ea5e9] bg-clip-text text-transparent">Developments</span>
        </span>
        <span class="text-[11px] font-medium tracking-wide text-dark-text/60 dark:text-light-text/60">Ronny Segura · Full Stack Developer</span>
      </span>
    </a>

    <!-- Enlaces (escritorio) -->
    <ul class="hidden lg:flex items-center gap-1 mx-auto nav-links">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class="nav-link relative px-3 py-2 rounded-lg text-sm font-medium text-dark-text/80 dark:text-light-text/80 hover:text-primary dark:hover:text-primary hover:bg-primary/5 transition-colors"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Acciones -->
    <div class="hidden lg:flex items-center gap-3 shrink-0">
      <NavPanelLink client:idle />
      <HireButton client:idle />
      <button
        class="darkModeToggle w-9 h-9 grid place-items-center rounded-full text-dark-text/70 dark:text-light-text/70 hover:bg-primary/10 hover:text-primary"
        aria-label="Cambiar tema"
        title="Cambiar tema"
      >
        <i class="fas fa-moon"></i>
      </button>
      <span class="w-px h-6 bg-dark-text/15 dark:bg-light-text/15"></span>
      <AuthButton client:idle />
    </div>

    <!-- Móvil -->
    <div class="lg:hidden ml-auto flex items-center gap-2">
      <button
        class="darkModeToggle w-9 h-9 grid place-items-center rounded-full text-dark-text/70 dark:text-light-text/70"
        aria-label="Cambiar tema"
      >
        <i class="fas fa-moon"></i>
      </button>
      <AuthButton client:media="(max-width: 1023px)" />
      <button
        id="menu-toggle"
        class="w-10 h-10 grid place-items-center rounded-lg text-dark-text dark:text-light-text hover:bg-primary/10"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <i class="fas fa-bars text-lg"></i>
      </button>
    </div>
  </nav>

  <!-- Menú móvil -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-dark-text/10 dark:border-light-text/10 bg-light-bg/95 dark:bg-dark-bg/95 backdrop-blur-xl">
    <ul class="container mx-auto px-4 py-2 nav-links">
      {links.map((l) => (
        <li>
          <a href={l.href} class="nav-link flex items-center gap-3 px-3 py-3 rounded-lg font-medium text-dark-text dark:text-light-text hover:bg-primary/10">
            <i class={`fas ${l.icon} w-5 text-primary/80`}></i>
            {l.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="container mx-auto px-4 pb-4 space-y-2">
      <NavPanelLink client:idle mobile />
      <HireButton client:idle block />
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const isHomePage = window.location.pathname === '/';
    const header = document.getElementById('main-header');

    // Enlaces de sección: desde otras páginas apuntan a la portada
    document.querySelectorAll<HTMLAnchorElement>('.nav-links a').forEach((link) => {
      const href = link.getAttribute('href');
      if (href?.startsWith('#') && !isHomePage) link.setAttribute('href', `/${href}`);
    });

    // Sombra al hacer scroll (el header siempre queda visible)
    const onScroll = () => {
      const scrolled = window.scrollY > 8;
      header?.classList.toggle('shadow-lg', scrolled);
      header?.classList.toggle('border-dark-text/10', scrolled);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Menú móvil
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const setMenu = (open: boolean) => {
      mobileMenu?.classList.toggle('hidden', !open);
      menuToggle?.setAttribute('aria-expanded', String(open));
      const icon = menuToggle?.querySelector('i');
      icon?.classList.toggle('fa-bars', !open);
      icon?.classList.toggle('fa-xmark', open);
    };
    menuToggle?.addEventListener('click', () => setMenu(mobileMenu?.classList.contains('hidden') ?? false));
    mobileMenu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

    // Tema claro / oscuro
    const html = document.documentElement;
    const toggles = document.querySelectorAll('.darkModeToggle');
    const updateIcon = () => {
      const dark = html.classList.contains('dark');
      toggles.forEach((t) => {
        const i = t.querySelector('i');
        i?.classList.toggle('fa-moon', !dark);
        i?.classList.toggle('fa-sun', dark);
      });
    };
    toggles.forEach((t) =>
      t.addEventListener('click', () => {
        html.classList.toggle('dark');
        localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
        updateIcon();
      }),
    );
    updateIcon();

    // Resalta la sección visible
    if (isHomePage) {
      const links = document.querySelectorAll<HTMLAnchorElement>('.nav-link[href^="#"]');
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            links.forEach((link) => link.classList.toggle('is-active', link.getAttribute('href') === `#${entry.target.id}`));
          });
        },
        { rootMargin: '-45% 0px -50% 0px' },
      );
      // Las secciones se hidratan con React: observar cuando existan
      const watch = () => document.querySelectorAll('section[id]').forEach((s) => observer.observe(s));
      watch();
      setTimeout(watch, 1500);
    }
  });
</script>

<style>
  .nav-link.is-active {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 8%, transparent);
  }
  .nav-link.is-active::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.25rem;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, #1d4ed8, #0ea5e9);
  }
</style>
