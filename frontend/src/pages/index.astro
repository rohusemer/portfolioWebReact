---
import Layout from '../layouts/Layout.astro';
import PortfolioSections from '../components/react/PortfolioSections';
import { getBuildData } from '../lib/buildData';

const data = await getBuildData();
---

<Layout title={`${data.profile.name} - ${data.profile.title}`}>
    <PortfolioSections client:load initialData={data} />
</Layout>
