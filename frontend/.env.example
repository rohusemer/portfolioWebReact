# Configuración web de Firebase.
# Consola de Firebase > Configuración del proyecto > Tus apps > App web > SDK config.
# Estos valores NO son secretos (van en el bundle público); la seguridad la dan
# las reglas de firestore.rules. Copia este archivo a `.env` y complétalo.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=portfoliowebsite-ccc81.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=portfoliowebsite-ccc81
PUBLIC_FIREBASE_STORAGE_BUCKET=portfoliowebsite-ccc81.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=505425957805
PUBLIC_FIREBASE_APP_ID=

# UID del administrador principal (debe coincidir con OWNER_UID en firestore.rules)
PUBLIC_OWNER_UID=x8d0hCPRy0bNgwHeub4C7ZB7K2q2
