rules_version = '2';

// ============================================================================
// Modelo de seguridad
// ----------------------------------------------------------------------------
// Autenticación: Firebase Auth (Google). Cada petición lleva un ID token JWT
// firmado por Google (RS256, caduca en 1 h y se renueva solo). Firestore valida
// la firma en el servidor; `request.auth` solo existe si el token es válido.
//
// Roles (users/{uid}.role):
//   owner   → el administrador. FIJO por UID. Único con acceso al panel, al
//             portafolio, al PDF del bot, a los mensajes y a la gestión de usuarios.
//   premium → su CV + página pública compartible.
//   user    → su propio CV. Rol por defecto al registrarse.
//   blocked → sin acceso.
//
// Permisos por sección (users/{uid}.permissions): el administrador decide qué
// puede hacer cada usuario en SU PROPIO CV (profiles/{uid}):
//   none | view | edit (modifica, sin agregar/eliminar; POR DEFECTO) | create (todo)
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // UID del administrador (también en PUBLIC_OWNER_UID del frontend)
    function ownerUid() {
      return 'x8d0hCPRy0bNgwHeub4C7ZB7K2q2';
    }

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && request.auth.uid == ownerUid();
    }

    function roleOf(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      return uid == ownerUid() ? 'owner' : (exists(path) ? get(path).data.role : 'none');
    }

    function myRole() {
      return signedIn() ? roleOf(request.auth.uid) : 'none';
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---- Permisos del usuario sobre su propio CV (por defecto: ver y editar) ----
    function perm(section) {
      return isOwner() ? 'create'
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data
            .get('permissions', {}).get(section, 'edit');
    }

    // Segundo factor del registro: el correo debe estar verificado (Google ya lo verifica)
    function verified() {
      return request.auth.token.email_verified == true;
    }

    // Un campo modificado es válido si el usuario tiene "create", o "edit" sin
    // cambiar la cantidad de elementos (no agrega ni elimina).
    function fieldOk(k, changed) {
      return !(k in changed)
        || perm(k) == 'create'
        || (perm(k) == 'edit'
          && (!(resource.data[k] is list) || request.resource.data[k].size() == resource.data[k].size()));
    }

    function profileUpdateOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['profile', 'contact', 'skills', 'experience', 'education', 'projects', 'languages', 'hobbies', 'cv', 'bot', 'isPublic', 'updatedAt'])
        && fieldOk('profile', changed) && fieldOk('contact', changed) && fieldOk('skills', changed)
        && fieldOk('experience', changed) && fieldOk('education', changed) && fieldOk('projects', changed)
        && fieldOk('languages', changed) && fieldOk('hobbies', changed) && fieldOk('cv', changed);
    }

    // ---------- Portafolio principal (solo el administrador) ----------
    match /portfolio/{docId} {
      allow read: if true;
      allow write: if isOwner() && request.resource.data.keys().hasAll(['profile', 'experience', 'education']);
    }

    // PDF publicado que entrega el bot
    match /cvPdf/{docId} {
      allow read: if true;
      allow write: if isOwner();
      match /chunks/{chunkId} {
        allow read: if true;
        allow write: if isOwner();
      }
    }

    // Configuración pública (planes, precio, enlace de pago)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // ---------- Usuarios ----------
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();

      // Registro automático: solo uno mismo y siempre con rol "user"
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.keys().hasOnly(['email', 'name', 'photoURL', 'provider', 'role', 'createdAt', 'lastLogin']);

      // El usuario actualiza sus datos básicos, nunca su rol ni sus permisos.
      // Puede elegir su nombre de usuario UNA vez, reservándolo en la misma operación.
      // El administrador asigna roles y permisos.
      allow update: if (signedIn() && request.auth.uid == uid && onlyChanges(['email', 'name', 'photoURL', 'provider', 'lastLogin']))
        || (signedIn() && request.auth.uid == uid && onlyChanges(['username'])
          && !('username' in resource.data)
          && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid)
        || (isOwner() && uid != ownerUid() && onlyChanges(['role', 'permissions'])
          && request.resource.data.role in ['premium', 'user', 'blocked']
          && request.resource.data.get('permissions', {}) is map);

      // El administrador elimina usuarios; cada usuario puede eliminar su propia cuenta
      allow delete: if uid != ownerUid() && (isOwner() || (signedIn() && request.auth.uid == uid));
    }

    // ---------- Nombres de usuario únicos ----------
    match /usernames/{name} {
      allow get: if true; // para comprobar disponibilidad y resolver /perfil?u=nombre
      allow list: if false;
      allow create: if signedIn()
        && name.matches('^[a-z0-9][a-z0-9._]{1,18}[a-z0-9]$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == name;
      allow update: if false;
      allow delete: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------- Solicitudes de permiso especial ----------
    match /roleRequests/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();

      // Requiere correo verificado (las cuentas de Google ya lo están)
      allow create, update: if signedIn() && request.auth.uid == uid && myRole() != 'blocked'
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'requestedRole', 'message', 'paymentRef', 'status', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedRole == 'premium'
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && request.resource.data.paymentRef is string && request.resource.data.paymentRef.size() <= 200;

      allow update: if isOwner() && onlyChanges(['status', 'reviewedAt'])
        && request.resource.data.status in ['approved', 'rejected'];

      allow delete: if isOwner() || (signedIn() && request.auth.uid == uid);
    }

    // ---------- CV de cada usuario ----------
    match /profiles/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid && myRole() != 'blocked')
        || isOwner()
        || (resource.data.get('isPublic', false) == true && roleOf(uid) in ['premium', 'owner']);

      // Creación al registrarse (plantilla + foto). Para editar después, el correo
      // debe estar verificado y cada cambio debe respetar sus permisos por sección.
      allow create: if signedIn() && request.auth.uid == uid && myRole() in ['owner', 'premium', 'user'];
      allow update: if signedIn() && request.auth.uid == uid && myRole() in ['owner', 'premium', 'user'] && verified() && profileUpdateOk();
      allow delete: if isOwner() || (signedIn() && request.auth.uid == uid);
    }

    // ---------- Mensajes y sugerencias del bot ----------
    // Cualquiera puede CREAR uno (validado); solo el administrador los lee.
    // Contacto: nombre y correo obligatorios. Sugerencia: anónima permitida.
    function validEmail(e) {
      return e is string && e.size() <= 150 && e.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    match /messages/{msgId} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'name', 'email', 'company', 'message', 'createdAt', 'read'])
        && request.resource.data.get('type', 'contact') in ['contact', 'suggestion']
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.company is string && request.resource.data.company.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt is string
        && request.resource.data.read == false
        && (request.resource.data.get('type', 'contact') == 'suggestion'
          ? (request.resource.data.email == '' || validEmail(request.resource.data.email))
          : (request.resource.data.name.size() > 0 && validEmail(request.resource.data.email)));
      allow read, delete: if isOwner();
      allow update: if isOwner() && onlyChanges(['read']);
    }

    // Todo lo demás, denegado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
