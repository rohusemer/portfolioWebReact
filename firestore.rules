rules_version = '2';

// Modelo de permisos basado en users/{uid}.role:
//   owner   → todo, incluida la gestión de usuarios y roles
//   editor  → edita el portafolio principal, publica el PDF y lee mensajes
//   user    → solo su propio CV (profiles/{uid})
//   blocked → sin acceso
// Cualquiera que inicia sesión se registra como "user". El primer "owner" se
// asigna a mano desde la consola de Firebase (users/{uid} → role: "owner").
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myRole() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn() && exists(path) ? get(path).data.role : 'none';
    }

    function isOwner() {
      return myRole() == 'owner';
    }

    function isStaff() {
      return myRole() in ['owner', 'editor'];
    }

    // ---------- Portafolio principal ----------
    match /portfolio/{docId} {
      allow read: if true;
      allow write: if isStaff()
        && request.resource.data.keys().hasAll(['profile', 'experience', 'education']);
    }

    // PDF publicado que entrega el bot
    match /cvPdf/{docId} {
      allow read: if true;
      allow write: if isStaff();
      match /chunks/{chunkId} {
        allow read: if true;
        allow write: if isStaff();
      }
    }

    // ---------- Usuarios ----------
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();

      // Registro: solo el propio usuario, y siempre con rol "user"
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.keys().hasOnly(['email', 'name', 'photoURL', 'role', 'createdAt', 'lastLogin']);

      // El usuario puede actualizar sus datos básicos, nunca su rol.
      // El owner puede cambiar el rol de cualquiera.
      allow update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'name', 'photoURL', 'lastLogin']))
        || (isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['owner', 'editor', 'user', 'blocked']);

      allow delete: if isOwner();
    }

    // CV personal de cada usuario
    match /profiles/{uid} {
      allow read: if signedIn() && ((request.auth.uid == uid && myRole() != 'blocked') || isOwner());
      allow write: if signedIn() && request.auth.uid == uid && myRole() in ['owner', 'editor', 'user'];
    }

    // ---------- Mensajes del bot ----------
    // Cualquiera puede CREAR uno (validado); solo el staff los lee o gestiona.
    match /messages/{msgId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'company', 'message', 'createdAt', 'read'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') && request.resource.data.email.size() <= 150
        && request.resource.data.company is string && request.resource.data.company.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt is string
        && request.resource.data.read == false;
      allow read, delete: if isStaff();
      allow update: if isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
